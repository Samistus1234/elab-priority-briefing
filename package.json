{
  "name": "elab-priority-briefing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily priority case briefing service for ELAB Solutions — WhatsApp to staff + Telegram rollup to CEO",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "brief:now": "tsx src/cli/brief-now.ts",
    "escalation:now": "tsx src/cli/escalation-now.ts",
    "mcp:digest:now": "tsx src/cli/mcp-digest-now.ts",
    "brain:synth:now": "tsx src/cli/brain-synth-now.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@huggingface/transformers": "^3.8.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
